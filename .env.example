# =============================================================================
# Taxlyn — Variables de entorno
# Copia a .env.local:  cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# BASE DE DATOS (PostgreSQL — Neon recomendado)
# -----------------------------------------------------------------------------
# Neon Dashboard → tu proyecto → Connection Details:
#
# DATABASE_URL  = connection string "Pooled" (termina en -pooler...)
# DIRECT_URL    = connection string "Direct" (sin pooler, para migraciones)
#
# Ejemplo Neon:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL="postgresql://user:pass@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require"
#
# Supabase (alternativa):
# DATABASE_URL = URI "Transaction" pooler (puerto 6543)
# DIRECT_URL   = URI "Session" direct (puerto 5432)
# -----------------------------------------------------------------------------

DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# -----------------------------------------------------------------------------
# OCR de facturas (DeepSeek) — SOLO SERVIDOR, nunca NEXT_PUBLIC_
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_INVOICE_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-flash

# -----------------------------------------------------------------------------
# URL pública de la app (única variable NEXT_PUBLIC_ obligatoria)
# -----------------------------------------------------------------------------
# Local:
#   NEXT_PUBLIC_APP_URL=http://localhost:3000
#   NEXTAUTH_URL=http://localhost:3000
#
# Producción:
#   NEXT_PUBLIC_APP_URL=https://taxlyn.com
#   NEXTAUTH_URL=https://taxlyn.com
#
# Tras cambiar la URL en producción, ejecuta: npm run native:config
# -----------------------------------------------------------------------------

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# NextAuth — OAuth social (Google / Outlook) — SOLO SERVIDOR
# -----------------------------------------------------------------------------
# Genera secreto: openssl rand -base64 32
#
# VERCEL (Settings → Environment Variables → Production):
#   NEXTAUTH_SECRET        = (openssl rand -base64 32)
#   NEXTAUTH_URL           = https://taxlyn.com
#   NEXT_PUBLIC_APP_URL    = https://taxlyn.com
#   GOOGLE_CLIENT_ID       = Google Cloud Console
#   GOOGLE_CLIENT_SECRET   = Google Cloud Console
#   AZURE_AD_CLIENT_ID     = Azure Portal → App registration (Application ID)
#   AZURE_AD_CLIENT_SECRET = Azure Portal → Certificates & secrets
#   AZURE_AD_TENANT_ID     = common  (multi-tenant) o GUID de tu tenant
#
# Redirect URIs en Google Cloud / Microsoft Entra (sustituir ORIGIN):
#   Google:  {ORIGIN}/api/oauth/callback/google
#            {ORIGIN}/api/auth/callback/google   (legacy, rewrite automático)
#   Outlook: {ORIGIN}/api/oauth/callback/azure-ad
#            {ORIGIN}/api/auth/callback/azure-ad (legacy)
#
# Páginas legales para verificación OAuth:
#   {ORIGIN}/politica-privacidad
#   {ORIGIN}/terminos-servicio
#
# Consulta URIs exactas en producción: GET /api/auth/oauth-status
# Guía completa: docs/OAUTH_PRODUCTION.md
# -----------------------------------------------------------------------------

NEXTAUTH_SECRET=your-nextauth-secret-here

# Correo que envía los códigos. Con Gmail: smtp.gmail.com, puerto 587 y una contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Taxlyn <infotaxlyn@gmail.com>

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=common

# -----------------------------------------------------------------------------
# AEAT — identidad legal del software (obligatoria para exportar Modelo 303)
# -----------------------------------------------------------------------------
# NIF legal de la entidad desarrolladora del software.
# En pruebas, si se deja vacío, cada fichero usa el NIF del cliente.
AEAT_DEVELOPER_NIF=
# Identificador alfanumérico de cuatro posiciones de esta versión.
AEAT_PROGRAM_VERSION=0102

# -----------------------------------------------------------------------------
# Object storage (PDFs, extractos, certificados .p12)
# -----------------------------------------------------------------------------
# En producción es obligatorio. Los binarios NO van a Git, ni a Postgres, ni al
# disco efímero de Vercel. Solo se guarda la ruta (storageKey) en PostgreSQL.
#
# Vercel Dashboard → Storage → Blob → Create Store (Private) → token RW:
BLOB_READ_WRITE_TOKEN=
#
# Clave AES-256 para cifrar certificados .p12/.pfx antes de Blob.
# Genera una: openssl rand -hex 32
CERTIFICATE_ENCRYPTION_KEY=

# Correos que pueden entrar en cualquier cuenta (además de infotaxlyn@gmail.com).
# Separados por comas. No convierte a los clientes en operadores.
PLATFORM_OPERATOR_EMAILS=
